# Copy to .env only in a private local environment. Never commit real secrets.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://localhost:5432/younoval
DATABASE_SSL=false

# Phone OTP is NOT active. Enable only after Russian hosting, legal review,
# provider due diligence, RKN notice (where required) and security testing.
AUTH_MODE=disabled
SMS_PROVIDER=not_selected
SMS_SENDER_ID=
SMS_API_KEY=
OTP_HMAC_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
